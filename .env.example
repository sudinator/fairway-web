# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase privileges (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GolfCourseAPI
GOLF_API_KEY=your_golfcourseapi_key

# Gemini round analysis
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
GEMINI_DAILY_LIMIT=your_global_daily_limit
GEMINI_USER_DAILY_LIMIT=your_per_user_daily_limit

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
PUSH_WEBHOOK_SECRET=your_push_webhook_secret

# Staging integration test environment
BNN_STAGING_SUPABASE_URL=your_staging_supabase_project_url
BNN_STAGING_SUPABASE_ANON_KEY=your_staging_supabase_anon_key
BNN_STAGING_SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key
BNN_STAGING_ALLOW_MUTATION=false

# Build/runtime values normally supplied by the build platform
NEXT_PUBLIC_APP_VERSION=generated_by_build
VERCEL_GIT_COMMIT_REF=provided_by_vercel
VERCEL_GIT_COMMIT_SHA=provided_by_vercel
